@model CartVM

@{
    ViewData["Title"] = "Checkout";
    var addresses = ViewBag.Addresses as List<Walmart.Domain.Entities.Address>;
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">💳 Checkout</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="CompleteCheckout" method="post">
        <div class="row">
            <div class="col-lg-8">
                
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="card-title mb-0">📍 Select Shipping Address</h4>
                            <a asp-controller="Address" asp-action="Add" asp-route-returnUrl="checkout" class="btn btn-sm btn-outline-primary">
                                ➕ Add New Address
                            </a>
                        </div>

                        @if (addresses != null && addresses.Any())
                        {
                            <div class="row g-3">
                                @foreach (var address in addresses)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                   type="radio" 
                                                   name="addressId" 
                                                   id="address_@address.Id" 
                                                   value="@address.Id" 
                                                   required
                                                   @(address.IsDefault ? "checked" : "")>
                                            <label class="form-check-label w-100" for="address_@address.Id">
                                                <div class="card @(address.IsDefault ? "border-success" : "")">
                                                    <div class="card-body">
                                                        @if (address.IsDefault)
                                                        {
                                                            <span class="badge bg-success mb-2">Default</span>
                                                        }
                                                        <p class="mb-1"><strong>@address.Street</strong></p>
                                                        <p class="mb-0">@address.City, @address.Country</p>
                                                        <p class="text-muted mb-0">@address.ZIP</p>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <strong>No addresses found!</strong> 
                                <a asp-controller="Address" asp-action="Add" class="alert-link">Add a shipping address</a> before checkout.
                            </div>
                        }
                    </div>
                </div>

                
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h4 class="card-title mb-4">📦 Order Items</h4>
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                                <div class="d-flex align-items-center">
                                    @if (item.ProductPicture != null)
                                    {
                                        <img src="data:image/png;base64,@Convert.ToBase64String(item.ProductPicture)" 
                                             style="width: 60px; height: 60px; object-fit: cover;" 
                                             class="rounded me-3" 
                                             alt="@item.ProductName" />
                                    }
                                    <div>
                                        <h6 class="mb-0">@item.ProductName</h6>
                                        <small class="text-muted">Quantity: @item.Quantity × $@item.Price.ToString("N2")</small>
                                    </div>
                                </div>
                                <span class="fw-bold">$@item.Total.ToString("N2")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-lg border-0 sticky-top" style="top: 20px;">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Order Summary</h4>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>$@Model.SubTotal.ToString("N2")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (10%):</span>
                            <span>$@Model.Tax.ToString("N2")</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total:</strong>
                            <strong class="text-success">$@Model.GrandTotal.ToString("N2")</strong>
                        </div>

                        @if (addresses != null && addresses.Any())
                        {
                            <button type="submit" class="btn btn-success btn-lg w-100 mb-2">
                                💳 Place Order
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-lg w-100 mb-2" disabled>
                                💳 Place Order
                            </button>
                            <small class="text-muted d-block text-center">Add address to continue</small>
                        }

                        <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">
                            ← Back to Cart
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
