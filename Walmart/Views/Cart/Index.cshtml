@model CartVM

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">🛒 Shopping Cart</h2>

    @if (Model.Items.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <div class="card mb-3 shadow-sm" id="cart-item-@item.ProductId">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    @if (item.ProductPicture != null)
                                    {
                                        <img src="data:image/png;base64,@Convert.ToBase64String(item.ProductPicture)" 
                                             class="img-fluid rounded" 
                                             alt="@item.ProductName" />
                                    }
                                    else
                                    {
                                        <img src="~/Images/DefaultProduct.jpg" 
                                             class="img-fluid rounded" 
                                             alt="@item.ProductName" />
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h5>@item.ProductName</h5>
                                    <p class="text-muted mb-0">$@item.Price.ToString("N2") each</p>
                                </div>
                                <div class="col-md-3">
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(@item.ProductId, -1)">-</button>
                                        <input type="number" class="form-control text-center" value="@item.Quantity" min="1" readonly id="item-quantity-@item.ProductId" data-price="@item.Price" />
                                        <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(@item.ProductId, 1)">+</button>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <p class="fw-bold text-success mb-0" id="item-total-@item.ProductId">$@item.Total.ToString("N2")</p>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-danger btn-sm" onclick="removeFromCart(@item.ProductId)">
                                        🗑️
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                        ← Continue Shopping
                    </a>
                    <button class="btn btn-outline-danger" onclick="clearCart()">
                        Clear Cart
                    </button>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-lg border-0">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Order Summary</h4>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span id="subtotal">$@Model.SubTotal.ToString("N2")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (10%):</span>
                            <span id="tax">$@Model.Tax.ToString("N2")</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total:</strong>
                            <strong class="text-success" id="grandtotal">$@Model.GrandTotal.ToString("N2")</strong>
                        </div>

                        <a asp-action="Checkout" class="btn btn-success btn-lg w-100">
                            Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size: 5rem; color: #ccc;"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <p class="text-muted">Add some products to your cart to continue shopping</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">
                Browse Products
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateQuantity(productId, quantity) {
            const input = document.getElementById(`item-quantity-${productId}`);
            if (input) input.disabled = true;

            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { productId: productId, quantity: quantity },
                success: function(result) {
                    if (input) input.disabled = false;
                    if (result.success) {
                        if (input) {
                            input.value = quantity;
                            const price = parseFloat(input.dataset.price);
                            const lineTotal = price * quantity;
                            document.getElementById(`item-total-${productId}`).textContent = `$${lineTotal.toFixed(2)}`;
                        }
                        
                        document.getElementById('subtotal').textContent = `$${result.subTotal.toFixed(2)}`;
                        const tax = result.subTotal * 0.1;
                        document.getElementById('tax').textContent = `$${tax.toFixed(2)}`;
                        document.getElementById('grandtotal').textContent = `$${result.grandTotal.toFixed(2)}`;
                        $('#cart-count').text(result.cartCount);
                        
                        window.showToast("Cart updated successfully!", "success");
                    } else {
                        window.showToast(result.message || "Could not update quantity.", "danger");
                    }
                },
                error: function() {
                    if (input) input.disabled = false;
                    window.showToast("Error updating cart quantity.", "danger");
                }
            });
        }

        function changeQuantity(productId, diff) {
            const input = document.getElementById(`item-quantity-${productId}`);
            if (!input) return;
            const currentVal = parseInt(input.value);
            const newVal = currentVal + diff;
            if (newVal >= 1) {
                updateQuantity(productId, newVal);
            }
        }

        function removeFromCart(productId) {
            window.showConfirmModal("Remove Item", "Remove this item from cart?", function() {
                $.ajax({
                    url: '@Url.Action("UpdateQuantity", "Cart")',
                    type: 'POST',
                    data: { productId: productId, quantity: 0 },
                    success: function(result) {
                        if (result.success) {
                            const itemCard = document.getElementById(`cart-item-${productId}`);
                            if (itemCard) {
                                itemCard.style.transition = "all 0.3s ease";
                                itemCard.style.opacity = "0";
                                itemCard.style.transform = "translateX(-20px)";
                                setTimeout(() => {
                                    itemCard.remove();
                                    
                                    if (result.cartCount === 0) {
                                        location.reload();
                                    } else {
                                        document.getElementById('subtotal').textContent = `$${result.subTotal.toFixed(2)}`;
                                        const tax = result.subTotal * 0.1;
                                        document.getElementById('tax').textContent = `$${tax.toFixed(2)}`;
                                        document.getElementById('grandtotal').textContent = `$${result.grandTotal.toFixed(2)}`;
                                        $('#cart-count').text(result.cartCount);
                                        window.showToast("Item removed from cart.", "success");
                                    }
                                }, 300);
                            }
                        }
                    },
                    error: function() {
                        window.showToast("Error removing item.", "danger");
                    }
                });
            });
        }

        function clearCart() {
            window.showConfirmModal("Clear Cart", "Clear all items from cart?", function() {
                $.ajax({
                    url: '@Url.Action("ClearCart", "Cart")',
                    type: 'POST',
                    success: function(result) {
                        if (result.success) {
                            window.showToast("Cart cleared.", "success");
                            setTimeout(() => {
                                location.reload();
                            }, 500);
                        }
                    },
                    error: function() {
                        window.showToast("Error clearing cart.", "danger");
                    }
                });
            });
        }
        
        $(document).ready(function() {
            $.ajax({
                url: '@Url.Action("GetCartCount", "Cart")',
                type: 'GET',
                success: function(result) {
                    $('#cart-count').text(result.count);
                }
            });
        });
    </script>
}
