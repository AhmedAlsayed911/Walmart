@model EditCategoryVM

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="mb-4 text-center">
                        ✏️ Edit Category
                    </h3>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        
                        <div class="mb-3">
                            <label asp-for="ParentCategoryId" class="form-label">Parent Category (Optional)</label>
                            <select asp-for="ParentCategoryId" asp-items="Model.ParentCategories" class="form-select">
                                <option value="">-- None (Root Category) --</option>
                            </select>
                            <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
                            <small class="text-muted">Cannot select itself as parent</small>
                        </div>

                        
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-dark">
                                💾 Update Category
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
