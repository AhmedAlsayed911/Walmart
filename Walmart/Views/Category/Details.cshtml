@model CategoryDetailsVM

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="card-title mb-0">📂 @Model.Name</h2>
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                    ✏️ Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                    <button type="submit" class="btn btn-danger">
                                        🗑️ Delete
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Category ID:</strong>
                            <p>@Model.Id</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Parent Category:</strong>
                            <p>@(Model.ParentCategoryName ?? "None (Root Category)")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Statistics:</strong>
                            <p>
                                <span class="badge bg-primary">@Model.ProductCount Products</span>
                                <span class="badge bg-info">@Model.SubCategoryCount Subcategories</span>
                            </p>
                        </div>
                    </div>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ← Back to Categories
                    </a>
                </div>
            </div>
        </div>
    </div>

    
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">🛍️ Products in @Model.Name</h3>
        </div>
    </div>

    <div class="row g-4" id="products-container">
        
    </div>

    <div id="no-products" class="alert alert-info text-center" style="display: none;">
        No products found in this category.
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadCategoryProducts(@Model.Id);
        });

        function loadCategoryProducts(categoryId) {
            $.ajax({
                url: '/api/products/category/' + categoryId,
                type: 'GET',
                success: function(products) {
                    if (products && products.length > 0) {
                        displayProducts(products);
                    } else {
                        
                        $('#no-products').show();
                    }
                },
                error: function() {
                    
                    $('#no-products').show();
                }
            });
        }

        function displayProducts(products) {
            var container = $('#products-container');
            container.empty();

            products.forEach(function(product) {
                var productCard = createProductCard(product);
                container.append(productCard);
            });
        }

        function createProductCard(product) {
            var imageHtml = product.productPicture
                ? `<img src="data:image/png;base64,${product.productPicture}" class="card-img-top" style="height: 200px; object-fit: cover;" alt="${product.name}">`
                : `<img src="/images/DefaultProduct.jpg" class="card-img-top" style="height: 200px; object-fit: cover;" alt="${product.name}">`;

            var stockBadge = product.stockQuantity > 10
                ? '<span class="badge bg-success">In Stock</span>'
                : product.stockQuantity > 0
                ? '<span class="badge bg-warning text-dark">Low Stock</span>'
                : '<span class="badge bg-danger">Out of Stock</span>';

            var addToCartBtn = product.stockQuantity > 0 && @(User.Identity.IsAuthenticated ? "true" : "false")
                ? `<button onclick="addToCart(${product.id})" class="btn btn-success btn-sm mt-2 w-100">🛒 Add to Cart</button>`
                : product.stockQuantity > 0
                ? `<a href="/Identity/Account/Login" class="btn btn-primary btn-sm mt-2 w-100">Login to Purchase</a>`
                : `<button class="btn btn-secondary btn-sm mt-2 w-100" disabled>Out of Stock</button>`;

            return `
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        ${imageHtml}
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold text-truncate">${product.name}</h6>
                            ${stockBadge}
                            <div class="mt-2 mb-2">
                                <span class="text-success fw-bold fs-5">$${product.price.toFixed(2)}</span>
                            </div>
                            <a href="/Product/Details/${product.id}" class="btn btn-dark btn-sm mt-auto">View Details</a>
                            ${addToCartBtn}
                        </div>
                    </div>
                </div>
            `;
        }

        function addToCart(productId) {
            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { productId: productId, quantity: 1 },
                success: function(result) {
                    if (result.success) {
                        alert('Product added to cart!');
                        $('#cart-count').text(result.cartCount);
                    } else {
                        alert(result.message);
                    }
                },
                error: function() {
                    alert('Error adding product to cart');
                }
            });
        }
    </script>
}

<style>
    .product-card {
        transition: transform 0.2s;
    }
    .product-card:hover {
        transform: translateY(-5px);
    }
</style>
