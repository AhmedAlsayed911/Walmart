<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Walmart</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Walmart.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom mb-5">
            <div class="container">
                <a class="navbar-brand-custom" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="navbar-logo-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" fill="#E6F0FF" stroke="#0052CC" stroke-width="2"/>
                        <path d="M7 9l3 6 2-4 2 4 3-6" stroke="#0052CC" stroke-width="2.5"/>
                    </svg>
                    <span class="brand-text">Walmart</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-area="" asp-controller="Category" asp-action="Index">Categories</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link-custom dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin Panel
                                </a>
                                <ul class="dropdown-menu border-0 shadow rounded-3 mt-2" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index">Manage Products</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="TopSold">Top 3 Sold Products</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Category" asp-action="Index">Manage Categories</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Order" asp-action="Index">Manage Orders</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2" asp-controller="User" asp-action="Index">Manage Users</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Role" asp-action="Index">Manage Roles</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center gap-1">
                        @if (User.IsInRole("Client"))
                        {
                            <li class="nav-item">
                                <a class="nav-link-custom d-flex align-items-center gap-1" asp-controller="Cart" asp-action="Index">
                                    🛒 Cart <span class="badge bg-danger rounded-pill px-2" id="cart-count">0</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-custom" asp-controller="Order" asp-action="MyOrders">My Orders</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom mt-auto">
        <div class="container">
            <div class="row align-items-center py-2">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                        <svg class="navbar-logo-svg" style="width: 28px; height: 28px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" fill="#E6F0FF" stroke="#0052CC" stroke-width="2"/>
                            <path d="M7 9l3 6 2-4 2 4 3-6" stroke="#0052CC" stroke-width="2.5"/>
                        </svg>
                        <span class="fw-bold brand-text" style="font-size: 1.2rem; letter-spacing: -0.5px;">Walmart</span>
                        <span class="text-muted ms-2">| &copy; 2026 All rights reserved.</span>
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a asp-controller="Home" asp-action="Index" class="btn-blue-link p-0 me-3 fs-7" style="font-size: 0.85rem;">Home</a>
                    <a asp-controller="Product" asp-action="Index" class="btn-blue-link p-0 me-3 fs-7" style="font-size: 0.85rem;">Products</a>
                    <a asp-controller="Category" asp-action="Index" class="btn-blue-link p-0 me-3 fs-7" style="font-size: 0.85rem;">Categories</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="btn-blue-link p-0 fs-7" style="font-size: 0.85rem;">Privacy Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Global Action Confirmation Modal -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-hidden="true" style="z-index: 9999;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 bg-light py-3">
                    <h5 class="modal-title fs-5" id="globalConfirmTitle">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4 fs-6" id="globalConfirmBody">
                    Are you sure you want to proceed?
                </div>
                <div class="modal-footer border-0 bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" data-bs-dismiss="modal" id="globalConfirmCancelBtn">Cancel</button>
                    <button type="button" class="btn btn-danger btn-sm px-4" id="globalConfirmBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 10000;"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            @if (User.IsInRole("Client"))
            {
                <text>
                $.ajax({
                    url: '@Url.Action("GetCartCount", "Cart")',
                    type: 'GET',
                    success: function(result) {
                        $('#cart-count').text(result.count);
                    }
                });
                </text>
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
