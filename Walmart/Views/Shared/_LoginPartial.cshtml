@using Microsoft.AspNetCore.Identity
@using Walmart.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var appUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
}

<ul class="navbar-nav align-items-center gap-1">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item d-flex align-items-center me-1">
        @if (appUser?.ProfilePicture is not null)
        {
            <img class="rounded-circle avatar" alt="profile" src="data:image/png;base64,@(Convert.ToBase64String(appUser.ProfilePicture))" style="width: 32px; height: 32px; object-fit: cover; border: 2px solid var(--primary-blue-light);" />
        }
        else
        {
            <img class="rounded-circle avatar" alt="profile" src="~/Images/profilepic.jpg" style="width: 32px; height: 32px; object-fit: cover; border: 2px solid var(--primary-blue-light);" />
        }
    </li>
    <li class="nav-item">
        <a class="nav-link-custom fw-semibold" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @(appUser != null ? appUser.FirstName : User.Identity?.Name)!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link-custom bg-transparent border-0" style="cursor: pointer;">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link-custom" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm ms-2" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
}
</ul>
