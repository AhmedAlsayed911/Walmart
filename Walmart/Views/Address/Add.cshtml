@model AddAddressVM

@{
    ViewData["Title"] = "Add Address";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="mb-4 text-center">
                        📍 Add New Address
                    </h3>

                    <form asp-action="Add" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">User</label>
                                <select asp-for="UserId" asp-items="Model.Users" class="form-select">
                                    <option value="">-- Select User --</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="UserId" />
                        }

                        <div class="mb-3">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" placeholder="123 Main Street" />
                            <span asp-validation-for="Street" class="text-danger"></span>
                        </div>

                        <div class="row">
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>

                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="ZIP" class="form-label"></label>
                                <input asp-for="ZIP" class="form-control" />
                                <span asp-validation-for="ZIP" class="text-danger"></span>
                            </div>
                        </div>

                        
                        <div class="mb-3">
                            <label asp-for="Country" class="form-label"></label>
                            <input asp-for="Country" class="form-control" />
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>

                        
                        <div class="mb-3 form-check">
                            <input asp-for="IsDefault" class="form-check-input" />
                            <label asp-for="IsDefault" class="form-check-label">
                                Set as default address
                            </label>
                        </div>

                        
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-dark">
                                💾 Save Address
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
