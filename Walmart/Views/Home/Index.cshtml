@{
    ViewData["Title"] = "Home Page";
}

<div class="bg-light py-5 mb-5">
    <div class="container text-center">
        <h1 class="display-3 fw-bold">Welcome to Walmart</h1>
        <p class="lead">Shop the best products at unbeatable prices</p>
        <div class="mt-4">
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg me-2">
                🛍️ Shop Now
            </a>
            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-lg">
                    Create Account
                </a>
            }
        </div>
    </div>
</div>

<div class="container">
    <div class="row text-center mb-5">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="display-4 mb-3">🚚</div>
                    <h4>Fast Delivery</h4>
                    <p class="text-muted">Get your products delivered quickly to your doorstep</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="display-4 mb-3">💰</div>
                    <h4>Best Prices</h4>
                    <p class="text-muted">Competitive pricing on all our products</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="display-4 mb-3">✅</div>
                    <h4>Quality Guaranteed</h4>
                    <p class="text-muted">100% authentic products with warranty</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mb-4">
        <h2 class="mb-4">Popular Categories</h2>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Category" asp-action="Index" class="btn btn-outline-dark">
                📂 All Categories
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark">
                🛍️ View All Products
            </a>
        </div>
    </div>
</div>
