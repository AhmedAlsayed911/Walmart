@model PaginatedResult<OrderListVM>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">📦 My Orders</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["OrderNotice"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @Html.Raw(TempData["OrderNotice"])
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Items)
                            {
                                <tr>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case 0:
                                                <span class="badge bg-warning text-dark">⏳ Pending</span>
                                                break;
                                            case 1:
                                                <span class="badge bg-info">📦 Processing</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-primary">🚚 On Way</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-success">✅ Deleivered</span>
                                                break;
                                            case 4:
                                                <span class="badge bg-danger">❌ Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@order.ProductCount items</span>
                                    </td>
                                    <td class="text-success fw-bold">$@order.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                                                👁️ View Details
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <tr class="table-light">
                                    <td colspan="6">
                                        <div class="small text-muted mb-2">Order lines:</div>
                                        @if (order.Items.Any())
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>Product</th>
                                                            <th class="text-center">Qty</th>
                                                            <th class="text-end">Unit Price</th>
                                                            <th class="text-end">Line Total</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var line in order.Items)
                                                        {
                                                            <tr>
                                                                <td>@line.ProductName</td>
                                                                <td class="text-center">@line.Quantity</td>
                                                                <td class="text-end">$@line.UnitPrice.ToString("N2")</td>
                                                                <td class="text-end">$@line.LineTotal.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="3" class="text-end fw-bold">Total Amount:</td>
                                                            <td class="text-end fw-bold">$@order.TotalAmount.ToString("N2")</td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No order lines found.</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <h4>📭 No orders yet</h4>
                    <p>You haven't placed any orders. Start shopping to see your orders here!</p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">
                        🛍️ Browse Products
                    </a>
                </div>
            }
        </div>
    </div>

    
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="MyOrders" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="MyOrders" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="MyOrders" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }

    <div class="text-center mt-4">
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
            ← Continue Shopping
        </a>
    </div>
</div>
