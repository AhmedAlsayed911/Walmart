@model PaginatedResult<OrderListVM>

@{
    ViewData["Title"] = "Orders Management";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">📦 Orders Management</h2>

    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-end mb-3">
            <a asp-action="Add" class="btn btn-success">
                ➕ Create New Order
            </a>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Items)
                            {
                                <tr>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td>
                                        @order.UserName<br />
                                        <small class="text-muted">@order.UserEmail</small>
                                    </td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case 0:
                                                <span class="badge bg-warning">Pending</span>
                                                break;
                                            case 1:
                                                <span class="badge bg-info">Processing</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-primary">Shipped</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-success">Delivered</span>
                                                break;
                                            case 4:
                                                <span class="badge bg-danger">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-success fw-bold">$@order.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                                👁️ View
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-warning">
                                                    ✏️
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@order.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        🗑️
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    No orders found.
                </div>
            }
        </div>
    </div>

    
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
